 "signals": [
  {
   "id": "sig.dynamo_start",
   "at": "1940-05-26T18:57",
   "from": "gb.dover_cmd",
   "kind": "order",
   "text": "Operation Dynamo is to commence. The Admiralty directs that the evacuation of the BEF from Dunkirk proceed with the utmost despatch, using all available naval and mercantile craft.",
   "zh": "「发电机行动」开始。海军部命令：以最快速度从敦刻尔克撤出英国远征军，动用一切可用的海军与商船船只。——1940 年 5 月 26 日 18:57，多佛指挥部作战室收到此令，拉姆齐海军中将随即签发第一批航渡命令。",
   "sources": [
    "dynamo_despatch",
    "national_archives_dynamo",
    "churchill_1949"
   ],
   "confidence": "high"
  },
  {
   "id": "sig.tennant_mole",
   "at": "1940-05-27T23:00",
   "from": "gb.dover_cmd",
   "to": "gb.dover_cmd",
   "kind": "signal",
   "text": "Send every available ship alongside the East Mole. We can load from the mole faster than from the beaches.",
   "zh": "让所有能靠的船都靠上东防波堤。从防波堤装载比从海滩快得多。——Tennant 上校 5 月 27 日抵达敦刻尔克后，发现港内码头已被炸毁、海滩装载太慢，遂把撤离改到东、西两道防波堤；此后近 20 万人由此登船。",
   "sources": [
    "dynamo_despatch",
    "lord_1982",
    "atkin_1990"
   ],
   "confidence": "high"
  },
  {
   "id": "sig.ramsay_smallcraft",
   "at": "1940-05-27T09:00",
   "from": "gb.dover_cmd",
   "kind": "radio",
   "text": "The Admiralty calls upon all owners of self-propelled pleasure craft between 30 and 100 feet in length to send full particulars to the Admiralty within fourteen days.",
   "zh": "海军部呼吁：凡拥有 30 至 100 英尺自航游艇者，请在十四日内向海军部申报全部船况。——5 月 27 日起 BBC 反复播送这条征用令，到 5 月 31 日已有近四百艘小艇自发渡海，成为「敦刻尔克小艇船队」。",
   "sources": [
    "dynamo_despatch",
    "divine_1940",
    "lord_1982"
   ],
   "confidence": "high"
  },
  {
   "id": "sig.ramsay_40k",
   "at": "1940-05-28T04:00",
   "from": "gb.dover_cmd",
   "kind": "order",
   "text": "It is hoped to evacuate 45,000 men of the BEF within two days. Assault shipping and small craft are to work the beaches at La Panne and Bray by night.",
   "zh": "计划在两天内撤出英国远征军 45,000 人。运输船与小艇须趁夜在拉帕讷、布雷迪讷海滩作业。——原定计划只打算救出 45,000 人；到 5 月 28 日实际运出 17,804 人，海军部开始意识到行动规模必须一再扩大。",
   "sources": [
    "dynamo_despatch",
    "dynamo_admiralty",
    "thompson_1956"
   ],
   "confidence": "high"
  },
  {
   "id": "sig.pound_destroyers",
   "at": "1940-05-29T20:00",
   "from": "gb.dover_cmd",
   "kind": "order",
   "text": "The First Sea Lord directs that the eight most modern destroyers be withdrawn from Operation Dynamo forthwith. Older destroyers, minesweepers and small craft are to continue.",
   "zh": "第一海务大臣令：最现代化的八艘驱逐舰立即撤出「发电机行动」，由较旧的驱逐舰、扫雷舰与小艇继续。——5 月 29 日一天之内英法损失 19 艘军舰与 3 艘大型征用船，海军部不愿把本土防卫的骨干一次赔光。",
   "sources": [
    "dynamo_despatch",
    "dynamo_admiralty",
    "atkin_1990"
   ],
   "confidence": "high"
  },
  {
   "id": "sig.darlan_equal",
   "at": "1940-05-31T15:00",
   "from": "fr.abrial",
   "kind": "diplomatic",
   "text": "L'évacuation doit se poursuivre à égalité entre les troupes britanniques et françaises. Les Britanniques formeront l'arrière-garde.",
   "zh": "撤离必须在英法部队之间平等进行，英军应担任殿后。——5 月 31 日达尔朗海军上将在巴黎会议上提出此要求；此前英舰常优先搭载英军，法方对此深感不满。此后英舰开始大量运送法军，约 102,250 名法军由英舰撤出。",
   "sources": [
    "dynamo_despatch",
    "churchill_1949",
    "abrial_1940"
   ],
   "confidence": "high"
  },
  {
   "id": "sig.french_night_2",
   "at": "1940-06-02T18:00",
   "from": "gb.dover_cmd",
   "kind": "order",
   "text": "Owing to heavy air attack by day, evacuation is to be carried out at night only. French troops to be embarked on an equal footing with our own.",
   "zh": "因白昼空袭猛烈，撤离改为只在夜间进行。法军部队须与英军同等登船。——6 月 1 日白天德军在敦刻尔克外海击沉 3 艘驱逐舰后，拉姆齐下令停止昼间撤离；6 月 2 日至 4 日夜又撤出约 7.5 万名法军。",
   "sources": [
    "dynamo_despatch",
    "dynamo_admiralty",
    "thompson_1956"
   ],
   "confidence": "high"
  },
  {
   "id": "sig.operation_complete",
   "at": "1940-06-04T10:30",
   "from": "gb.dover_cmd",
   "kind": "order",
   "text": "Operation Dynamo is terminated. The evacuation from Dunkirk is completed.",
   "zh": "「发电机行动」终止，敦刻尔克撤离结束。——1940 年 6 月 4 日 10:30，拉姆齐海军中将在多佛宣布行动结束。九昼夜共撤出 338,226 人；同日 09:00，桥头堡内的 4 万名法军殿后部队向德军投降。",
   "sources": [
    "dynamo_despatch",
    "dynamo_admiralty",
    "national_archives_dynamo"
   ],
   "confidence": "high"
  },
  {
   "id": "sig.churchill_beaches",
   "at": "1940-06-04T15:30",
   "from": "gb.dover_cmd",
   "kind": "report",
   "text": "We shall fight on the beaches, we shall fight on the landing grounds, we shall fight in the fields and in the streets, we shall never surrender.",
   "zh": "我们将在海滩上作战，我们将在敌人登陆地点作战，我们将在田野和街道上作战，我们决不投降。——丘吉尔 6 月 4 日在下院的演说。他同时提醒：「战争不是靠撤退赢得的」，但把这次救援称为「一个奇迹般的解脱」。",
   "sources": [
    "churchill_1949",
    "hansard_1940",
    "commons_dunkirk"
   ],
   "confidence": "high"
  },
  {
