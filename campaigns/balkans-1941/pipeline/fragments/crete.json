    {
      "id": "e.cr_last_evacuation",
      "at": "1941-05-31T12:00",
      "category": "naval",
      "precision": "day",
      "importance": 1,
      "title": {
        "zh": "斯法基亚最后一夜海撤"
      },
      "body": "指挥部决定31日夜间为最后一次有组织撤离。船位有限，优先登舰的是还能整队行动的步兵和伤员；更多人员仍在岸上等待。皇家海军在空袭损失与舰艇故障下继续执行任务，澳新部队及部分陆战队离岛后，仍留下数千名盟军士兵。",
      "place": "@cr_sfakia",
      "units": [
        "gb.mediterranean_crete",
        "nz.5b_crete",
        "au.19b_crete"
      ],
      "sources": [
