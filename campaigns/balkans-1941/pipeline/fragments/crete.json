    },
    {
      "id": "e.cr_retimo_surrender",
      "at": "1941-05-30T12:00",
      "category": "surrender",
      "precision": "day",
      "importance": 2,
      "title": {
        "zh": "雷西姆诺守军投降"
      },
      "body": "西部德军抵达后，雷西姆诺防区已难以继续独立维持。未收到有效撤离指示的澳大利亚和希腊守军在补给与弹药不足下投降，另有一部分人员分散进入山区。此前德国伞兵多日未能拿下机场，这里的结局来自战区隔离和地面增援到达。",
      "place": "@cr_retimo_airfield",
      "units": [
        "au.retimo_crete",
