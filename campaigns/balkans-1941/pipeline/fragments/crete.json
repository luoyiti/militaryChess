  "equipment": [
    {
      "id": "cr_ju52",
      "side": "DE",
      "name": {
        "zh": "Ju 52/3m运输机"
      },
      "class": "transport",
      "desc": "三发运输机承担伞兵投送与机场空运任务。马莱迈开放后，它将山地部队和重武器送上岛，但拥挤机场、防空射击与受损机体造成持续损耗。作为运输装备列出，数量不与作战飞机合并。",
      "sources": [
        "cr_usarmy",
        "cr_awm"
      ],
      "photo": {
        "commons": "File:Maleme airfield Crete with Ju 52s 1941.jpg",
        "caption": "马莱迈机场上的Ju 52运输机，1941年5月。"
      }
    },
    {
      "id": "cr_dfs230",
      "side": "DE",
      "name": {
        "zh": "DFS 230滑翔机"
      },
      "class": "glider",
      "desc": "突击滑翔机将少量部队送到机场与防区附近，依靠牵引机到达目标上空。其低噪声进场不能消除守军火力威胁，许多滑翔机在克里特降落时被击毁或迫降，不能作为地面车辆沿道路前进。",
      "sources": [
        "cr_usarmy",
        "cr_awm"
      ]
    },
    {
      "id": "cr_kar98",
      "side": "DE",
      "name": {
        "zh": "Kar 98k步枪"
      },
      "class": "small_arms",
      "desc": "德军伞兵和山地步兵常用的栓动步枪。空降武器箱能否顺利回收影响首批部队的战斗能力；山地增援携带步兵武器与补给后，德军才获得更稳定的地面作战能力。",
      "sources": [
        "cr_usarmy",
        "cr_awm",
        "cr_cunningham"
      ]
    },
    {
      "id": "cr_mp40",
      "side": "DE",
      "name": {
        "zh": "MP 40冲锋枪"
      },
      "class": "small_arms",
      "desc": "部分德国突击和空降人员携带的冲锋枪，适用于村落、机场设施和近距离战斗。它是部队装备的代表，不表示所有伞兵均使用同一种武器，也不承担对守军重装备的替代作用。",
      "sources": [
        "cr_usarmy",
        "cr_awm",
        "cr_cunningham"
      ]
    },
    {
      "id": "cr_lee_enfield",
      "side": "GB",
      "name": {
        "zh": "Lee–Enfield步枪"
      },
      "class": "small_arms",
      "desc": "英国及英联邦守军普遍使用的步枪。澳新步兵在机场防御、加拉塔斯反攻和山区后卫战中依靠步枪、轻机枪与少量炮火作战；撤离过程中可以带走轻武器，较重装备往往被留下。",
      "sources": [
        "cr_usarmy",
        "cr_awm",
        "cr_cunningham"
      ]
    },
    {
      "id": "cr_bren",
      "side": "GB",
      "name": {
        "zh": "Bren轻机枪"
      },
      "class": "small_arms",
      "desc": "英联邦步兵班的重要支援武器，可由步兵携行进入山地和村庄阵地。守军利用掩蔽地形射击降落中的伞兵，但在补给受阻、人员伤亡和持续空袭下，单靠轻机枪无法维持整岛防御。",
      "sources": [
        "cr_usarmy",
        "cr_awm",
        "cr_cunningham"
      ]
    },
    {
      "id": "cr_phoebe",
      "side": "GB",
      "name": {
        "zh": "HMS Phoebe巡洋舰"
      },
      "class": "ship",
      "desc": "皇家海军巡洋舰参加克里特周边海上行动，并在最后一夜撤离中返回斯法基亚接走守军。舰艇的主要作用是巡逻、拦截和运输；航路以海域示意呈现，赴亚历山大目的地在图幅以外。",
      "sources": [
        "cr_usarmy",
        "cr_awm",
        "cr_cunningham"
      ]
    }
  ],
