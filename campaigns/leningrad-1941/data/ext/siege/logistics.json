[
  {
    "id": "ladoga-ice",
    "key": "siegeIceVisible",
    "label": "拉多加湖冰道",
    "segments": [
      {
        "from": "1941-11-20T00:00",
        "state": "restricted",
        "note": "11月20日先有马拉雪橇；21日试行少量汽车。22日晚开始主要汽车车队运输，不能把最初通行等同成熟运力。",
        "sources": [
          "civil_source_ice_1941",
          "civil_source_kovalchuk_ice1"
        ],
        "until": "1941-11-22T00:00"
      },
      {
        "from": "1941-11-22T00:00",
        "state": "regular",
        "note": "第一冰运季的主要汽车运输期；冰厚、裂缝、风雪及空袭使路线与载荷持续调整。",
        "sources": [
          "civil_source_kovalchuk_ice1",
          "civil_source_ice_1941"
        ],
        "until": "1942-04-21T00:00"
      },
      {
        "from": "1942-04-21T00:00",
        "state": "restricted",
        "note": "4月21日中午下令结束通常汽车运输；22—24日仍有特殊军运、马运和步行搬运。24日16时全部通行停止；按日显示包含24日。",
        "sources": [
          "civil_source_kovalchuk_ice1"
        ],
        "until": "1942-04-25T00:00"
      },
      {
        "from": "1942-12-19T00:00",
        "state": "restricted",
        "note": "第二季19日先允许行人、20日马运，23日汽车试行；24日才开放常规汽车货运，同时仍有受限水运。",
        "sources": [
          "civil_source_kovalchuk_ice2",
          "civil_source_overlap_report"
        ],
        "until": "1942-12-24T00:00"
      },
      {
        "from": "1942-12-24T00:00",
        "state": "regular",
        "note": "第二个冬季的常规汽车货运，服务城市和方面军。冰道与1943年2月通车的铁路并行使用。",
        "sources": [
          "civil_source_kovalchuk_ice2"
        ],
        "until": "1943-03-30T00:00"
      },
      {
        "from": "1943-03-30T00:00",
        "state": "uncertain",
        "note": "3月底结束汽车冰运：科瓦利丘克记30日关闭命令，内河运输史记31日结束。此两日表示文献口径差异，不能视为确认仍有常规运输。",
        "sources": [
          "civil_source_kovalchuk_ice2",
          "civil_source_river_transport"
        ],
        "until": "1943-04-01T00:00"
      }
    ]
  },
  {
    "id": "ladoga-water",
    "key": "siegeWaterVisible",
    "label": "拉多加湖水路",
    "segments": [
      {
        "from": "1941-09-12T00:00",
        "state": "regular",
        "note": "首批驳船9月12日抵奥西诺韦茨；秋季常规水运逐渐受到风暴、低温和结冰限制。",
        "sources": [
          "civil_source_water_1941",
          "civil_source_kovalchuk_water1"
        ],
        "until": "1941-11-10T00:00"
      },
      {
        "from": "1941-11-10T00:00",
        "state": "restricted",
        "note": "11月10日前后驳船运输受阻，官方概述常以15日作首季终点；较强船舶仍于11月27日、12月4日送达粮食。这不是每天连续可航的保证。",
        "sources": [
          "civil_source_kovalchuk_water1",
          "civil_source_water_1941"
        ],
        "until": "1941-12-05T00:00"
      },
      {
        "from": "1942-05-22T00:00",
        "state": "restricted",
        "note": "5月22日首批约40吨面粉抵湖西岸；短航线、长航线和各类船舶的启用日期不同。",
        "sources": [
          "civil_source_kovalchuk_water2"
        ],
        "until": "1942-05-23T00:00"
      },
      {
        "from": "1942-05-23T00:00",
        "state": "regular",
        "note": "5月23日短线开始常规运输，28日新拉多加长线开航；货运、人员军运与平民撤离分别组织。",
        "sources": [
          "civil_source_kovalchuk_water2"
        ],
        "until": "1942-11-09T00:00"
      },
      {
        "from": "1942-11-09T00:00",
        "state": "restricted",
        "note": "11月起小型船陆续停航，大船仍运行；长短线末批常规船队分别在11月29、30日出发。12月13—14日及其后至1月8日仍有冰区特殊军运，与冰道交叠。",
        "sources": [
          "civil_source_kovalchuk_water2",
          "civil_source_overlap_report"
        ],
        "until": "1943-01-09T00:00"
      },
      {
        "from": "1943-04-02T00:00",
        "state": "restricted",
        "note": "4月2日已有首批货船抵达，浮冰使部分船舶被困；4月26日清水航运恢复。不能以整个4月一律畅通或一律停航。",
        "sources": [
          "civil_source_river_transport"
        ],
        "until": "1943-04-26T00:00"
      },
      {
        "from": "1943-04-26T00:00",
        "state": "uncertain",
        "note": "已证实1943年春夏秋继续运送军需、燃料和木材，铁路开通未使湖运消失；本轮未核实晚期终航日。此未定终点不证明1943年冬季每天可航。",
        "sources": [
          "civil_source_river_transport",
          "civil_source_navigation1943_order"
        ]
      }
    ]
  },
  {
    "id": "victory-rail",
    "key": "siegeRailVisible",
    "label": "胜利之路铁路",
    "segments": [
      {
        "from": "1943-02-07T00:00",
        "state": "regular",
        "note": "2月5日线路交付，7日首列供应列车抵达列宁格勒；新线仍在德军炮火威胁下，与湖上运输互补。此处表示供给通道，不代表全线客运或完全解围。",
        "sources": [
          "civil_source_victory_rail",
          "civil_source_river_transport"
        ]
      }
    ]
  },
  {
    "id": "ladoga-pipeline",
    "key": "siegePipelineVisible",
    "label": "拉多加湖底输油管",
    "segments": [
      {
        "from": "1942-06-18T00:00",
        "state": "regular",
        "note": "6月14日湖底段铺成，试压后18日投入使用，19日有米高扬报告；通道存在不表示每日都有输送，1942航季也因缺少待运燃料多次停输。油管与输电电缆不同。",
        "sources": [
          "civil_source_pipeline_report",
          "civil_source_pipeline_collection",
          "civil_source_kovalchuk_water2",
          "civil_source_kovalchuk_ice2"
        ],
        "until": "1943-04-01T00:00"
      },
      {
        "from": "1943-04-01T00:00",
        "state": "uncertain",
        "note": "运输史确认第二冰运季仍经油管输送燃料；1943年春以后各阶段停输、停用日尚未核定。本分界表示资料覆盖边界，不能当作4月1日停用。",
        "sources": [
          "civil_source_kovalchuk_ice2"
        ]
      }
    ]
  },
  {
    "id": "ladoga-cable",
    "key": "siegeCableVisible",
    "label": "生命电缆",
    "segments": [
      {
        "from": "1942-09-23T00:00",
        "state": "regular",
        "note": "9月23日首批湖底电缆将沃尔霍夫电站电力送入城网；电缆与油管是不同工程，不能据此断言全城已恢复战前供电。",
        "sources": [
          "civil_source_cable_operator",
          "civil_source_cable_hydro"
        ]
      }
    ]
  }
]
