  "intro": {
    "stamp": "GEHEIM · SECRET · 绝密",
    "kicker": "作战档案 No. 1940/V",
    "title": "法国战役",
    "en": "Fall Gelb · The Battle of France",
    "dates": "1940年5月10日 — 6月25日",
    "paragraphs": [
      "5月10日拂晓，德军以黄色方案攻入荷兰、比利时和卢森堡，装甲部队穿过阿登，在色当渡过默兹河，十天后到达英吉利海峡。北方的同盟军退入敦刻尔克。6月5日红色方案展开，6月14日巴黎陷落，6月22日在贡比涅签署停战协定。"
    ],
    "how": "这是可播放的基础版：集团军和几支著名装甲部队、{keyframes} 个战线关键帧、若干推进箭头，以及时间轴上的简短事件。位置是示意，不是实测阵地图。",
    "note": "建议开启声音 · 支持鼠标滚轮缩放、拖动平移 · 历史示意图，边界与位置为近似",
    "photo": "File:Bundesarchiv Bild 101I-126-0347-09A, Frankreich, Panzer IV.jpg",
    "photoFallback": "File:Dunkirk 26-29 May 1940 NYP68075.jpg"
  },
