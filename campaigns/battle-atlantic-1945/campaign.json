 "phases": [
  {
   "id": "ph1",
   "from": "1939-09-03T00:00",
   "name": "袭击舰与护航制度",
   "short": "袭击舰与护航",
   "sub": "斯卡帕湾、拉瓦尔品第与南大西洋的猎杀群；英国从本土向外逐段建立船团制，远洋仍无全程护航",
   "center": [
    -20,
    50
   ],
   "zoom": 3.6
  },
  {
   "id": "ph2",
   "from": "1940-06-22T00:00",
   "name": "法国基地与「快乐时光」",
   "short": "快乐时光",
   "sub": "比斯开湾港口让 U 艇往返航程缩短约三分之一；狼群在 SC 7 与 HX 79 两夜之间证明多艇水面夜袭",
   "center": [
    -18,
    50
   ],
   "zoom": 4.0
  },
  {
   "id": "ph3a",
   "from": "1941-04-01T00:00",
   "name": "美国介入",
   "short": "美国介入",
   "sub": "租借法案、美洲安全区西扩与纽芬兰护航部队：美国从中立巡逻走向事实上的西大西洋护航",
   "center": [
    -40,
    44
   ],
   "zoom": 2.0
  },
  {
   "id": "bismarck",
   "from": "1941-05-23T00:00",
   "name": "俾斯麦追击",
   "short": "俾斯麦",
   "sub": "胡德号在丹麦海峡爆炸；本土舰队主力尽出追击，5 月 27 日俾斯麦号在比斯开湾以西沉没（两场炮战在时间轴上各放慢到半分钟上下）",
   "center": [
    -28,
    56
   ],
   "zoom": 3.0
  },
  {
   "id": "ph3",
   "from": "1941-05-28T00:00",
   "name": "全域扩张",
   "short": "全域扩张",
   "sub": "大西洋宪章、冰岛防务移交与「见即击沉」；对美宣战后 U 艇扑向无人护航的美国东岸与加勒比",
   "center": [
    -42,
    38
   ],
   "zoom": 1.7
  },
  {
   "id": "ph4",
   "from": "1942-07-01T00:00",
   "name": "转折",
   "short": "转折",
   "sub": "PQ-17 解散、火炬行动与狼群集中打中大西洋空白区；1943 年 3 月的船团战与 5 月的崩盘只隔八周",
   "center": [
    -36,
    50
   ],
   "zoom": 3.2
  },
  {
   "id": "ph5",
   "from": "1943-06-01T00:00",
   "name": "反攻",
   "short": "反攻",
   "sub": "护航航母猎杀群与超远程航空兵关闭空白区；比斯开湾封锁、莱特恩反扑与北角海战",
   "center": [
    -25,
    47
   ],
   "zoom": 3.0
  },
  {
   "id": "ph6",
   "from": "1944-06-06T00:00",
   "name": "诺曼底与基地失守",
   "short": "诺曼底",
   "sub": "登陆海域的反潜封锁、通气管 U 艇的短暂回潮，以及 8 月比斯开湾基地的陷落",
