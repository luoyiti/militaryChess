  "intro": {
    "stamp": "SECRET · RAF · 绝密",
    "kicker": "作战档案 No. 1940/VII",
    "title": "不列颠空战",
    "en": "The Battle of Britain",
    "dates": "1940年7月10日 — 10月31日",
    "paragraphs": [
      "1940年夏，德国空军跨越海峡，试图夺取英国上空的制空权。皇家空军依靠雷达、地面指挥和战斗机中队，迎击一轮又一轮的空袭。从海峡船队到防空机场，再到伦敦，两军在英伦上空展开决战。"
    ],
    "how": "沿时间轴探索五个阶段、{events}个关键事件，查看双方编制、示意出击航线和空战态势。地图与3D沙盘共用同一战役时钟。",
    "note": "建议开启声音 · 支持鼠标滚轮缩放、拖动平移 · 历史示意图，航迹与空战范围为重建示意",
    "photo": "File:The Battle of Britain HU54418.jpg",
    "caption": "1940年7月29日，霍金奇机场的第32中队飞行员"
  },
