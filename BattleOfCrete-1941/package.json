{
  "name": "crete-1941-wargame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "1941 克里特岛战役 · 战旗推演",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5195 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4195 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "frame": "node scripts/frame/emit_frame.mjs",
    "validate:data": "node --import tsx scripts/validate/validate_data.ts",
    "debug:render": "node --import tsx scripts/debug/render_debug.ts",
    "verify": "npm run typecheck && npm run test && npm run validate:data -- --quiet && vite build",
    "shots": "node scripts/qa-crete.mjs"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-contour": "^4.0.2",
    "d3-ease": "^3.0.1",
    "d3-geo": "^3.1.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "polylabel": "^2.1.0",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-zoom": "^3.0.8",
    "@types/geojson": "^7946.0.16",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "mapshaper": "^0.7.68",
    "milsymbol": "^3.0.4",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
