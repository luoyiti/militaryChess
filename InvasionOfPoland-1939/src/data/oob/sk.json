  {"id": "sk.bernolak", "side": "SK", "echelon": "army", "type": "hq", "parent": "de.ag_sud", "name": {"zh": "“贝尔诺拉克”野战集团军", "orig": "Poľná armáda Bernolák", "short": "Bernolák"}, "commander": {"zh": "恰特洛什", "orig": "Ferdinand Čatloš"}, "strength": {"men": 51306}, "track": [{"at": "1939-08-31T12:00", "pos": "@spisska_nova_ves", "status": "active", "note": "司令部设于斯皮什新村"}, {"at": "1939-09-08T12:00", "pos": "@presov", "status": "active", "note": "司令部移至普雷绍夫附近索利瓦尔"}, {"at": "1939-10-05T12:00", "pos": "@poprad", "status": "active", "note": "波普拉德胜利阅兵"}, {"at": "1939-10-06T20:00", "pos": "@poprad", "status": "disbanded", "note": "10/7 撤编"}], "history": "斯洛伐克共和国于 8 月 26 日动员，组建由国防部长恰特洛什指挥、约 5.1 万人的“贝尔诺拉克”野战集团军，辖 3 个步兵师和“卡林恰克”快速集群，隶属德国第 14 集团军，任务是防止波军攻入斯洛伐克并掩护德军侧翼。9 月 1 日起越境占领 1920 年和 1938 年有争议的边境地区，战役中阵亡 37 人。10 月 5 日在波普拉德举行阅兵，7 日撤编。", "sources": ["wiki_slovak_invasion", "de_wiki_bernolak"], "confidence": "medium"},
